{
  "name": "@aegis/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AEGIS Investigation UI — React frontend for the AEGIS attribution platform (Phase 23).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "lint": "eslint \"src/**/*.{ts,tsx}\" vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/node": "~20.14.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "eslint": "^9.12.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.11.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.9"
  }
}
